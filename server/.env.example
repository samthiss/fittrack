ANTHROPIC_API_KEY=sk-ant-your-key-here

# Web Push (rappels sur le téléphone). Sans ces clés, la fonctionnalité reste désactivée et
# l'app le dit dans Réglages > Rappels. Générer une paire avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par la spec Web Push, montré aux services de push en cas de problème.
VAPID_SUBJECT=mailto:ton.email@example.com
